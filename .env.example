# MongoDB connection string
MONGODB_URI="mongodb://localhost:27017/attendance"

# Office geo-fence
OFFICE_LATITUDE="28.6139"
OFFICE_LONGITUDE="77.2090"
OFFICE_RADIUS_METERS="70"

# Shift cutoff (24h, server-local time) — after this, check-ins are "Late"
SHIFT_CUTOFF_HOUR="9"
SHIFT_CUTOFF_MINUTE="15"

# Admin login. Set your own ID/password.
# ADMIN_SESSION_SECRET signs the login cookie: use 32+ random characters,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
ADMIN_ID="admin"
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET=""
