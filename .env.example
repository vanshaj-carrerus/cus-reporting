# MongoDB connection string
MONGODB_URI="mongodb://localhost:27017/attendance"

# Office geo-fence
OFFICE_LATITUDE="28.6139"
OFFICE_LONGITUDE="77.2090"
OFFICE_RADIUS_METERS="70"

# Shift cutoff (24h, IST) — after this, check-ins are "Late"
SHIFT_CUTOFF_HOUR="9"
SHIFT_CUTOFF_MINUTE="15"

# Admin login. Set your own ID/password.
# ADMIN_SESSION_SECRET signs the login cookie: use 32+ random characters,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
ADMIN_ID="admin"
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET=""

# Public address of this site, used for the QR code on /qr (phones need a real address, not localhost)
# APP_URL="https://attendance.yourcompany.com"

# Email (nodemailer) — sends the verification code employees use to set or reset
# their password. Any SMTP account works. Example for Gmail / Google Workspace:
#   SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@yourcompany.com,
#   SMTP_PASS=<a Google "App password" — needs 2-Step Verification on>
# Port 587 uses STARTTLS; port 465 uses implicit TLS (or force it with SMTP_SECURE=true|false).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# The "From" the employee sees, e.g. CUS Shift <no-reply@yourcompany.com> (defaults to SMTP_USER)
MAIL_FROM=""
